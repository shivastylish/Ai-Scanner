APP_NAME=AI Screener
APP_VERSION=0.2.0-dev
ENVIRONMENT=development

LOG_LEVEL=INFO

DATABASE_URL=sqlite:///data/ai_screener.db

DEFAULT_EQUITY_PROVIDER=yahoo
DEFAULT_MUTUAL_FUND_PROVIDER=mfapi
# Used when asset_type="crypto" is requested without naming a specific
# exchange (provider_name=...). Individual exchanges are still reachable
# by name regardless of this default.
DEFAULT_CRYPTO_PROVIDER=coingecko

ENABLE_YAHOO=true
ENABLE_MFAPI=true

# Binance, Bybit, KuCoin, and CoinGecko's OHLC endpoint used here are all
# public market-data endpoints - no API key required for the read-only
# historical price data this app downloads. The *_API_KEY/*_SECRET_KEY
# placeholders below are for future trading/account-level features, not
# needed for anything currently implemented.
ENABLE_COINGECKO=true
ENABLE_BINANCE=true
ENABLE_BYBIT=true
ENABLE_KUCOIN=true

# CoinMarketCap's OHLCV endpoint requires a paid API key even on the free
# tier - set COINMARKETCAP_API_KEY and flip this to true to enable it.
ENABLE_COINMARKETCAP=false

COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=

BINANCE_API_KEY=
BINANCE_SECRET_KEY=

BYBIT_API_KEY=
BYBIT_SECRET_KEY=

KUCOIN_API_KEY=
KUCOIN_SECRET_KEY=
